# Variable TrueType-outline builds of Noto CJK. Unlike the CFF builds in
# noto-fonts-cjk, Qt renders them without stem darkening and gamma-corrected
# blending, so they don't look bold as light text on dark backgrounds.

pkgname=noto-fonts-cjk-ttf
pkgver=20240730
pkgrel=1
_sansver=2.004
_serifver=2.003
pkgdesc="Google Noto CJK fonts (variable TrueType builds)"
arch=(any)
url="https://github.com/notofonts/noto-cjk"
license=(OFL-1.1)
provides=(noto-fonts-cjk)
conflicts=(noto-fonts-cjk)
_raw="https://raw.githubusercontent.com/notofonts/noto-cjk"
source=("$_raw/Sans$_sansver/Sans/Variable/OTC/NotoSansCJK-VF.ttf.ttc"
        "$_raw/Sans$_sansver/Sans/Variable/OTC/NotoSansMonoCJK-VF.ttf.ttc"
        "$_raw/Serif$_serifver/Serif/Variable/OTC/NotoSerifCJK-VF.ttf.ttc"
        "$_raw/Sans$_sansver/LICENSE")
sha256sums=('2abbfc7ff74a086cf2c1f5be6130528791cfd2c8b83466db5a1463aa63252ca7'
            'b861b923e105a437f30ce12573350e899ee75766c4a6e9eef6d46788fb839e76'
            'e0be8fdd4f01c9807ee856ee0d30147f663c5ab397c491c80134266f58d1fffe'
            '6a73f9541c2de74158c0e7cf6b0a58ef774f5a780bf191f2d7ec9cc53efe2bf2')

package() {
  install -Dm644 -t "$pkgdir/usr/share/fonts/noto-cjk" *.ttc
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
